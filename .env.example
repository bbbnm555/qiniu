# ===========================================
# AI视觉对话助手 - 环境变量模板
# 复制此文件为 .env 并填入真实值
# ===========================================

# ---- 服务端口 ----
PORT=3001
FRONTEND_URL=http://localhost:5173

# ---- AI 视觉模型 ----
# 支持 OpenAI 兼容接口 (OpenAI / 通义千问 / DeepSeek 等)
#
# 阿里云 通义千问:
#   VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   VISION_MODEL=qwen-vl-plus (或 qwen-vl-max)
#   获取 Key: https://dashscope.console.aliyun.com/apiKey
#
# OpenAI:
#   VISION_API_URL=https://api.openai.com/v1/chat/completions
#   VISION_MODEL=gpt-4o
#   获取 Key: https://platform.openai.com/api-keys
#
# DeepSeek:
#   VISION_API_URL=https://api.deepseek.com/v1/chat/completions
#   VISION_MODEL=deepseek-chat
#   获取 Key: https://platform.deepseek.com/api_keys
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_API_KEY=sk-your-key-here
VISION_MODEL=gpt-4o

# ---- TTS 语音合成 ----
# 如果留空，后端 TTS 服务不启用（前端会使用浏览器内置语音合成作为降级）
TTS_API_URL=https://api.openai.com/v1/audio/speech
TTS_API_KEY=
TTS_VOICE=alloy

# ---- 七牛云 ----
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=first-cc-assets
QINIU_CDN_DOMAIN=https://cdn.example.com
QINIU_UPLOAD_ZONE=z2

# ---- 日志级别 ----
LOG_LEVEL=info
